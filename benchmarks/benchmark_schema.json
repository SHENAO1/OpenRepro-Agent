{
  "schema_version": "0.6.0",
  "description": "Schema for OpenRepro-Agent workflow-compliance benchmark tasks. v0.6.0 records workflow evidence and provenance only; it does not report scientific benchmark scores.",
  "required_fields": [
    "task_id",
    "paper_title",
    "source_files"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "paper_title": {"type": "string"},
    "source_files": {"type": "array", "items": {"type": "string"}},
    "artifacts": {
      "type": "object",
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "array", "items": {"type": "string"}}
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}},
        "optional": {"type": "array", "items": {"type": "string"}}
      }
    },
    "workflow": {
      "type": "object",
      "properties": {
        "run_demo": {"type": "boolean"},
        "run_sweep": {"type": "boolean"}
      }
    },
    "pass_criteria": {
      "type": "object",
      "properties": {
        "require_manifest_valid": {"type": "boolean"}
      }
    },
    "expected_artifacts": {"type": "array", "items": {"type": "string"}},
    "evaluation_metrics": {"type": "array", "items": {"type": "string"}},
    "dataset": {"type": ["object", "string", "null"]},
    "environment": {"type": ["object", "string", "null"]},
    "dependencies": {"type": ["array", "object", "string", "null"]},
    "paper_source": {"type": ["object", "string", "null"]},
    "expected_runtime_notes": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
