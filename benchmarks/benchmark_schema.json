{
  "schema_version": "0.3.0",
  "description": "Schema for OpenRepro-Agent workflow-compliance benchmark tasks. v0.3.0 records evidence only and does not report scientific benchmark scores.",
  "required_fields": [
    "task_id",
    "paper_title",
    "source_files",
    "expected_artifacts",
    "evaluation_metrics"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "paper_title": {"type": "string"},
    "source_files": {"type": "array", "items": {"type": "string"}},
    "expected_artifacts": {"type": "array", "items": {"type": "string"}},
    "evaluation_metrics": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
